# Copia este archivo a .env y rellena lo que tengas. Nada de esto se sube a GitHub.

# Base de datos (SQLite)
RADIO_DB=data/radio.sqlite3

# Telegram: crea un bot con @BotFather y pon aquí su token y tu chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Token secreto que usa el lector de X de tu PC para enviar posts al servidor
INGEST_TOKEN=cambia-esto-por-algo-largo-y-aleatorio
# Puerto de esa API (el instalador elige uno libre si está vacío)
INGEST_PORT=

# Gemini (gratis con límites): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fortnite Tracker: https://fortnitetracker.com/site-api
TRN_API_KEY=

# fortnite-api.com (opcional para noticias del juego)
FORTNITE_API_KEY=

# Contacto que se envía a Liquipedia en el User-Agent (lo exigen sus normas)
LIQUIPEDIA_CONTACT=
