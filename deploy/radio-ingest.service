[Unit]
Description=podcast-fortnite: API que recibe los posts de X desde el PC
After=network-online.target

[Service]
User=radio
WorkingDirectory=/opt/podcast-fortnite
EnvironmentFile=/opt/podcast-fortnite/.env
ExecStart=/opt/podcast-fortnite/.venv/bin/python -m radio serve --port ${INGEST_PORT}
Restart=always
RestartSec=5
# Prioridad baja y límites para no quitarle recursos a otros programas del servidor.
Nice=10
CPUQuota=50%
MemoryMax=1G

[Install]
WantedBy=multi-user.target
